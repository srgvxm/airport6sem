@model IEnumerable<Flight>
@{
    ViewData["Title"] = "Отчет о загруженности рейсов";
    Layout = "_AdminLayout";
}
<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <h1>@ViewData["Title"]</h1>
    <span class="badge bg-primary fs-6">На дату: @DateTime.Today.ToString("dd.MM.yyyy")</span>
</div>
<div class="admin-card">
    <div class="admin-card-header">
        <h5 class="admin-card-title">Состояние рейсов</h5>
    </div>
    <div class="admin-card-body p-0">
        @if (Model.Any())
        {
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>№ рейса</th>
                        <th>Самолет</th>
                        <th>Время вылета</th>
                        <th style="width: 250px;">Загруженность</th>
                        <th>Свободные места</th>
                        <th>Цена</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.FlightNumber</td>
                            <td>@item.Aircraft.Name</td>
                            <td>@item.DepartureTime.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>
                                <div class="progress" style="height: 20px;">
                                    <div class="progress-bar @GetProgressBarClass(item.LoadPercentage)" 
                                         role="progressbar" 
                                         style="width: @item.LoadPercentage%;" 
                                         aria-valuenow="@item.LoadPercentage" 
                                         aria-valuemin="0" 
                                         aria-valuemax="100">
                                        @item.LoadPercentage%
                                    </div>
                                </div>
                            </td>
                            <td>@item.AvailableSeats из @item.Aircraft.SeatCount</td>
                            <td>@item.Price.ToString("C")</td>
                            <td>
                                @if (item.AvailableSeats > 0)
                                {
                                    <a asp-controller="Ticket" asp-action="Create" asp-route-flightId="@item.Id" class="admin-btn admin-btn-sm admin-btn-primary">
                                        <i class="fas fa-plus-circle"></i> Продать
                                    </a>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Нет мест</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="p-4 text-center">
                <div class="alert alert-info">Нет активных рейсов.</div>
            </div>
        }
    </div>
</div>
@functions {
    public string GetProgressBarClass(int percentage)
    {
        if (percentage >= 80)
            return "bg-danger";
        else if (percentage >= 50)
            return "bg-warning";
        else
            return "bg-success";
    }
} 

