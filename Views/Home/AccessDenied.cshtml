@{
    ViewData["Title"] = "Доступ запрещен";
}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="display-1 text-danger mb-4">
                <i class="fas fa-lock"></i>
            </div>
            <h1 class="display-4">403</h1>
            <h2 class="mb-4">Доступ запрещен</h2>
            <p class="lead mb-5">У вас нет прав для просмотра этой страницы. Если вы считаете, что это ошибка, обратитесь к администратору.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg">Вернуться на главную</a>
        </div>
    </div>
</div>

