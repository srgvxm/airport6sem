@model Airport.Models.User
@using Airport.ViewModels
@{
    ViewData["Title"] = "Личный кабинет";
    var updateModel  = (UpdateProfileViewModel)ViewBag.UpdateProfileModel;
    var passwordModel = (ChangePasswordViewModel)ViewBag.ChangePasswordModel;
    var activeTab    = (string?)ViewBag.ActiveTab ?? "profile";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-7">

            @if (TempData["ProfileSuccess"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show">
                    <i class="fas fa-check-circle me-2"></i>@TempData["ProfileSuccess"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["ProfileError"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show">
                    <i class="fas fa-exclamation-circle me-2"></i>@TempData["ProfileError"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["PasswordSuccess"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show">
                    <i class="fas fa-check-circle me-2"></i>@TempData["PasswordSuccess"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["PasswordError"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show">
                    <i class="fas fa-exclamation-circle me-2"></i>@TempData["PasswordError"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="card shadow-sm mb-4">
                <div class="card-body d-flex align-items-center gap-3 py-3 px-4">
                    <div class="rounded-circle bg-primary d-flex align-items-center justify-content-center text-white fw-bold"
                         style="width:52px;height:52px;font-size:1.4rem;flex-shrink:0;">
                        @Model.Username[0].ToString().ToUpper()
                    </div>
                    <div>
                        <div class="fw-bold fs-5">@Model.Username</div>
                        <div class="text-muted small">@Model.Email</div>
                        <span class="badge @(Model.Role == "Admin" ? "bg-danger" : "bg-secondary") mt-1">@Model.Role</span>
                    </div>
                    <div class="ms-auto text-muted small">
                        Зарегистрирован: @Model.CreatedAt.ToString("dd.MM.yyyy")
                    </div>
                </div>
            </div>

            <ul class="nav nav-tabs mb-4" id="profileTabs">
                <li class="nav-item">
                    <a class="nav-link @(activeTab == "profile" ? "active" : "")"
                       href="#" data-tab="profile" onclick="switchTab('profile'); return false;">
                        <i class="fas fa-user-edit me-1"></i> Данные аккаунта
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(activeTab == "password" ? "active" : "")"
                       href="#" data-tab="password" onclick="switchTab('password'); return false;">
                        <i class="fas fa-key me-1"></i> Смена пароля
                    </a>
                </li>
            </ul>

            @* Вкладка: данные аккаунта *@
            <div id="tab-profile" class="@(activeTab == "profile" ? "" : "d-none")">
                <div class="card shadow-sm">
                    <div class="card-header fw-semibold">Изменить данные аккаунта</div>
                    <div class="card-body">
                        <form asp-action="UpdateProfile" method="post">
                            @Html.AntiForgeryToken()
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Имя пользователя</label>
                                <input type="text" name="Username" class="form-control"
                                       value="@updateModel.Username" />
                                <span class="text-danger small">
                                    @Html.ValidationMessage("Username")
                                </span>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Email</label>
                                <input type="email" name="Email" class="form-control"
                                       value="@updateModel.Email" />
                                <span class="text-danger small">
                                    @Html.ValidationMessage("Email")
                                </span>
                            </div>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save me-1"></i> Сохранить
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            @* Вкладка: смена пароля *@
            <div id="tab-password" class="@(activeTab == "password" ? "" : "d-none")">
                <div class="card shadow-sm">
                    <div class="card-header fw-semibold">Изменить пароль</div>
                    <div class="card-body">
                        <form asp-action="ChangePassword" method="post">
                            @Html.AntiForgeryToken()
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Текущий пароль</label>
                                <input type="password" name="CurrentPassword" class="form-control" />
                                <span class="text-danger small">
                                    @Html.ValidationMessage("CurrentPassword")
                                </span>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Новый пароль</label>
                                <input type="password" name="NewPassword" class="form-control" />
                                <span class="text-danger small">
                                    @Html.ValidationMessage("NewPassword")
                                </span>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Подтверждение нового пароля</label>
                                <input type="password" name="ConfirmNewPassword" class="form-control" />
                                <span class="text-danger small">
                                    @Html.ValidationMessage("ConfirmNewPassword")
                                </span>
                            </div>
                            <button type="submit" class="btn btn-warning">
                                <i class="fas fa-key me-1"></i> Изменить пароль
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <div class="mt-4">
                <form asp-action="Logout" method="post">
                    <button type="submit" class="btn btn-outline-danger">
                        <i class="fas fa-sign-out-alt me-1"></i> Выйти
                    </button>
                </form>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        function switchTab(name) {
            document.getElementById('tab-profile').classList.add('d-none');
            document.getElementById('tab-password').classList.add('d-none');
            document.getElementById('tab-' + name).classList.remove('d-none');
            document.querySelectorAll('#profileTabs .nav-link').forEach(function(el) {
                el.classList.toggle('active', el.dataset.tab === name);
            });
        }
    </script>
}
